{
  "manifest_version": 3,
  "name": "Vrishn - Quick Tab Switcher",
  "description": "Keyboard-first quick tab switcher with MRU cycling and fuzzy title/URL search.",
  "version": "0.4.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "Vrishn - Quick Tab Switcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-switcher": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Open alt-tab-style popup"
    },
    "open-search-switcher": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Search in alt-tab-style popup"
    },
    "toggle-last-tab": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Switch to previous tab"
    }
  }
}
